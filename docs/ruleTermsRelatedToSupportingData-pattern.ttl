BASE <https://w3id.org/itsdata/metr/>
PREFIX : <https://w3id.org/itsdata/metr/>
PREFIX cc: <http://creativecommons.org/ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:ruleTermsRelatedToSupportingData a owl:Ontology ;
    dcterms:title "Rule Terms Related to Supporting Data"@en ;
    dcterms:modified "2026-09-22"^^xsd:date ;
    owl:imports <core.ttl> .

:condition-basedRule a owl:Class ;
    rdfs:subClassOf :rule ;
    skos:definition "[rule](rule.md) that becomes [active](active rule.md) based on explicitly stated conditions"@en ;
    skos:example "“when workers present”"@en,
        "“dusk”"@en,
        "\"08:00 - 12:00\""@en ;
    skos:note "Condition-based rules can be based on multiple conditions."@en,
        "Time-based rules (e.g., a parking rule that is only in effect during certain hours) are one type of condition-based rules."@en ;
    skos:prefLabel "condition-based rule"@en ;
    :clause "3.2.9.1"@en .

:time-basedRule a owl:Class ;
    rdfs:subClassOf :condition-basedRule ;
    skos:definition "[condition-based rule](condition-based rule.md) where at least one condition is dependent on time"@en ;
    skos:example "\"08:00-12:00\""@en,
        "\"Every Tuesday\""@en,
        "\"June through July\""@en ;
    skos:prefLabel "time-based rule"@en ;
    :clause "3.2.9.2"@en .

:variableRule a owl:Class ;
    rdfs:subClassOf :rule ;
    skos:definition "[rule](rule.md) that contains a parameter whose value is dependent upon supporting data (3.2.1.12) issued by a [rule maker](rule maker.md)"@en ;
    skos:example "A speed limit that changes based on RLA decisions"@en,
        "A traffic signal, which changes states as determined by a traffic signal controller"@en ;
    skos:note "The supporting data can be generated by an automated system under the authority of the RLA."@en ;
    skos:prefLabel "variable rule"@en ;
    :clause "3.2.9.3"@en .
