BASE <https://w3id.org/itsdata/metr/>
PREFIX : <https://w3id.org/itsdata/metr/>
PREFIX cc: <http://creativecommons.org/ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:ruleRelevancyTerms a owl:Ontology ;
    dcterms:title "Rule Relevancy Terms"@en ;
    dcterms:modified "2026-09-22"^^xsd:date ;
    owl:imports <core.ttl> .

:non-relevantRule a owl:Class ;
    rdfs:subClassOf :rule ;
    skos:definition "[rule](rule.md) that is not applicable to the [METR user](METR user.md) within present circumstances"@en ;
    skos:prefLabel "non-relevant rule"@en ;
    :clause "3.2.10.1"@en .

:relevantRule a owl:Class ;
    rdfs:subClassOf :rule ;
    skos:definition "[rule](rule.md) applicable to the [METR user](METR user.md) within present circumstances"@en ;
    skos:prefLabel "relevant rule"@en ;
    :clause "3.2.10.2"@en .
