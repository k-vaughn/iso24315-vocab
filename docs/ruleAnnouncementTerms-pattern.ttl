BASE <https://w3id.org/itsdata/metr/>
PREFIX : <https://w3id.org/itsdata/metr/>
PREFIX cc: <http://creativecommons.org/ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:ruleAnnouncementTerms a owl:Ontology ;
    dcterms:title "Rule Announcement Terms"@en ;
    dcterms:modified "2026-09-22"^^xsd:date ;
    owl:imports <core.ttl> .

:emergentRule a owl:Class ;
    rdfs:subClassOf :metrRule ;
    skos:definition "[METR rule](METR rule.md) created and implemented while previously distributed, pre-announced [rule sets](rule set.md) are still fresh (3.2.5.1)"@en ;
    skos:example "Immediately after downloading the current pre-announced rule set, the [jurisdictional entity](jurisdictional entity.md) issues a new [METR rule](METR rule.md) that closes a lane on a road due to a vehicular collision."@en ;
    skos:note "Derived from SP-66,SP-133,SP-54."@en,
        "Emergent rules typically require alternate distribution mechanisms to ensure that [METR users](METR user.md) are notified in time to allow for operational decisions."@en,
        "Emergent rules can include both [temporary](temporary rule.md) and [persistent](persistent rule.md) rules."@en ;
    skos:prefLabel "emergent rule"@en ;
    :clause "3.2.7.1"@en .

:pre-announcedRule a owl:Class ;
    rdfs:subClassOf :metrRule ;
    skos:definition "[METR rule](METR rule.md) distributed through the normal periodic update mechanism"@en ;
    skos:note "Derived from SP-133."@en,
        "Pre-announced rules do not require low-latency communications because they are distributed well enough in advance so that all users with up-to-date [rule sets](rule set.md) will have a copy of the rule."@en,
        "Pre-announced rules typically have relatively long [freshness periods](freshness period.md) but can be impacted by [emergent rules](emergent rule.md)."@en ;
    skos:prefLabel "pre-announced rule"@en ;
    :clause "3.2.7.2"@en .
